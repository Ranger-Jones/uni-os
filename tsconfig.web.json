{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@core/*": ["./src/core/*"], "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts", "src/core/**/*.ts", "src/main/router.ts"]
}
