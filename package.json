{
  "name": "unios",
  "productName": "UniOS",
  "version": "0.6.0",
  "description": "Notion-inspired study organizer with LLM integration",
  "main": "out/main/index.js",
  "author": {
    "name": "UniOS",
    "email": "info@eventings.de"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:all": "electron-vite build && electron-builder --mac --win --linux --publish never",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@blocknote/core": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@blocknote/server-util": "^0.56.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "1.0.13",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.9.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-darwin-arm64": "1.0.13",
    "@napi-rs/canvas-darwin-x64": "1.0.13",
    "@napi-rs/canvas-linux-x64-gnu": "1.0.13",
    "@napi-rs/canvas-win32-x64-msvc": "1.0.13"
  },
  "devDependencies": {
    "@blocknote/mantine": "^0.56.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "homepage": "https://github.com/Ranger-Jones/uni-os",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ranger-Jones/uni-os.git"
  }
}
